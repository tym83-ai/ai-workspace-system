set -euo pipefail

mode="normal"
dry_run=0
interactive_commit=0
clone_missing=1
clone_only=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --scheduled) mode="scheduled" ;;
    --dry-run) dry_run=1 ;;
    --commit) interactive_commit=1 ;;
    --clone-only) clone_only=1 ;;
    --no-clone-missing) clone_missing=0 ;;
    -h|--help)
      cat <<'EOF'
Usage: workspace-sync [--scheduled] [--dry-run] [--commit] [--clone-only] [--no-clone-missing]

Default:
  Clone missing repos from GITHUB_ORG, then fetch, pull clean repos,
  and push committed local changes.

--scheduled:
  Safe cron/systemd mode. Never commits automatically.

--commit:
  Interactively commit dirty repos before syncing.

--clone-only:
  Clone missing repos from GITHUB_ORG, then exit.

--no-clone-missing:
  Skip GitHub-to-local discovery and cloning.

--dry-run:
  Print actions without running pull/push/commit.
EOF
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
  shift
done

config="${AI_WORKSPACE_CONFIG:-$HOME/.config/ai-workspace/config}"
if [[ -f "$config" ]]; then
  # shellcheck disable=SC1090
  source "$config"
fi

PROJECTS_HOME="${PROJECTS_HOME:-$HOME/projects}"
PROJECT_ROOTS="${PROJECT_ROOTS:-$PROJECTS_HOME}"
SYNC_ROOTS="${SYNC_ROOTS:-$PROJECTS_HOME}"
GITHUB_ORG="${GITHUB_ORG:-}"
GITHUB_SYNC_REPOS="${GITHUB_SYNC_REPOS:-1}"
GITHUB_CLONE_PROTOCOL="${GITHUB_CLONE_PROTOCOL:-https}"
GITHUB_REPO_LIMIT="${GITHUB_REPO_LIMIT:-200}"
BACKUP_REMOTE="${BACKUP_REMOTE:-backup}"
SECRET_SCAN_CMD="${SECRET_SCAN_CMD:-}"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
lock_file="${AI_WORKSPACE_SYNC_LOCK:-$cache_home/ai-workspace-sync.lock}"
log_dir="${AI_WORKSPACE_LOG_DIR:-$state_home/ai-workspace/logs}"
mkdir -p "$(dirname "$lock_file")" "$log_dir"

log_file="$log_dir/workspace-sync-$(date +%Y-%m-%d).log"

run() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
  if [[ "$dry_run" = "0" ]]; then
    "$@"
  fi
}

expand_home() {
  local path="$1"
  printf '%s\n' "${path/#\~/$HOME}"
}

discover_repos() {
  local root
  local -a roots
  IFS=':' read -r -a roots <<< "$SYNC_ROOTS"
  for root in "${roots[@]}"; do
    root="$(expand_home "$root")"
    [[ -d "$root" ]] || continue
    find "$root" -maxdepth 4 -path '*/.git' -type d -prune -print 2>/dev/null | while read -r gitdir; do
      printf '%s\n' "${gitdir%/.git}"
    done
  done | sort -u
}

discover_known_repos() {
  local root root_list
  local -a roots
  root_list="$SYNC_ROOTS:$PROJECT_ROOTS:$PROJECTS_HOME"
  IFS=':' read -r -a roots <<< "$root_list"
  for root in "${roots[@]}"; do
    root="$(expand_home "$root")"
    [[ -d "$root" ]] || continue
    find "$root" -maxdepth 4 -path '*/.git' -type d -prune -print 2>/dev/null | while read -r gitdir; do
      printf '%s\n' "${gitdir%/.git}"
    done
  done | sort -u
}

remote_is_org() {
  local url="$1"
  local org="$2"

  [[ -n "$org" ]] || return 1
  [[ "$url" == *"github.com/$org/"* || "$url" == *"github.com:$org/"* ]]
}

remote_matches_github_repo() {
  local remote="$1"
  local name="$2"
  local https_url="$3"
  local ssh_url="$4"

  [[ "$remote" == "$https_url" || "$remote" == "$https_url.git" ]] && return 0
  [[ "$remote" == "$ssh_url" || "$remote" == "$ssh_url.git" ]] && return 0
  [[ "$remote" == "https://github.com/$GITHUB_ORG/$name" ]] && return 0
  [[ "$remote" == "https://github.com/$GITHUB_ORG/$name.git" ]] && return 0
  [[ "$remote" == "git@github.com:$GITHUB_ORG/$name.git" ]] && return 0
  [[ "$remote" == "ssh://git@github.com/$GITHUB_ORG/$name.git" ]] && return 0

  return 1
}

github_repo_already_local() {
  local name="$1"
  local https_url="$2"
  local ssh_url="$3"
  local repo remote

  while IFS= read -r repo || [ -n "$repo" ]; do
    remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
    if remote_matches_github_repo "$remote" "$name" "$https_url" "$ssh_url"; then
      echo "ok: GitHub repo already local: $repo"
      return 0
    fi
  done < <(discover_known_repos)

  return 1
}

github_clone_url() {
  local https_url="$1"
  local ssh_url="$2"

  case "$GITHUB_CLONE_PROTOCOL" in
    ssh) printf '%s\n' "$ssh_url" ;;
    https) printf '%s\n' "$https_url" ;;
    *)
      echo "warn: unknown GITHUB_CLONE_PROTOCOL=$GITHUB_CLONE_PROTOCOL; using https" >&2
      printf '%s\n' "$https_url"
      ;;
  esac
}

clone_missing_github_repos() {
  local clone_root repo_lines name https_url ssh_url clone_url target

  [[ "$clone_missing" = "1" || "$clone_only" = "1" ]] || return 0
  [[ "$GITHUB_SYNC_REPOS" != "0" || "$clone_only" = "1" ]] || return 0
  [[ -n "$GITHUB_ORG" ]] || return 0

  if ! command -v gh >/dev/null 2>&1; then
    echo "warn: gh not found; skip GitHub repo discovery"
    return 0
  fi

  clone_root="$(expand_home "$PROJECTS_HOME")"
  echo
  echo "== GitHub discovery: $GITHUB_ORG -> $clone_root"
  run mkdir -p "$clone_root"

  if ! repo_lines="$(gh repo list "$GITHUB_ORG" --limit "$GITHUB_REPO_LIMIT" --json name,url,sshUrl --jq '.[] | [.name, .url, .sshUrl] | @tsv' 2>&1)"; then
    echo "warn: cannot list GitHub repos for $GITHUB_ORG"
    printf '%s\n' "$repo_lines" | sed 's/^/warn: /'
    return 0
  fi

  if [[ -z "$repo_lines" ]]; then
    echo "ok: no GitHub repos found"
    return 0
  fi

  while IFS=$'\t' read -r name https_url ssh_url || [ -n "$name" ]; do
    [[ -n "$name" ]] || continue
    target="$clone_root/$name"

    if [[ -d "$target/.git" ]]; then
      echo "ok: already cloned: $target"
      continue
    fi

    if github_repo_already_local "$name" "$https_url" "$ssh_url"; then
      continue
    fi

    if [[ -e "$target" ]]; then
      echo "skip clone: path exists but is not a git repo: $target"
      continue
    fi

    clone_url="$(github_clone_url "$https_url" "$ssh_url")"
    run git clone "$clone_url" "$target"
  done <<< "$repo_lines"
}

confirm_secret_scan() {
  local repo="$1"
  local safe_answer

  [[ -n "$SECRET_SCAN_CMD" ]] || return 0

  echo "secret scan: $SECRET_SCAN_CMD"
  if [[ "$dry_run" = "0" ]]; then
    if ! bash -lc "$SECRET_SCAN_CMD \"\$1\"" ai-workspace-secret-scan "$repo"; then
      echo "warn: secret scan command exited non-zero"
    fi
  else
    printf '+ bash -lc %q ai-workspace-secret-scan %q\n' "$SECRET_SCAN_CMD \"\$1\"" "$repo"
  fi

  read -r -p "Proceed with commit after reviewing secret scan output? [y/N] " safe_answer
  case "$safe_answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

sync_repo() {
  local repo="$1"
  local branch remote backup dirty upstream ahead behind upstream_remote

  echo
  echo "== $repo"

  remote="$(git -C "$repo" remote get-url origin 2>/dev/null || true)"
  if [[ -z "$remote" ]]; then
    echo "skip: no origin remote"
    return 0
  fi

  branch="$(git -C "$repo" branch --show-current 2>/dev/null || true)"
  if [[ -z "$branch" ]]; then
    echo "skip: detached HEAD or no branch"
    return 0
  fi

  backup="$(git -C "$repo" remote get-url "$BACKUP_REMOTE" 2>/dev/null || true)"
  if remote_is_org "$remote" "$GITHUB_ORG"; then
    upstream_remote="origin"
  else
    upstream_remote="$BACKUP_REMOTE"
  fi

  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    if [[ "$interactive_commit" = "1" && "$mode" != "scheduled" ]]; then
      git -C "$repo" status --short
      read -r -p "Commit all changes in $(basename "$repo")? [y/N] " answer
      case "$answer" in
        y|Y|yes|YES)
          if ! confirm_secret_scan "$repo"; then
            echo "skip: commit declined"
            return 0
          fi
          read -r -p "Commit message: " message
          message="${message:-chore: workspace sync checkpoint}"
          run git -C "$repo" add -A
          run git -C "$repo" commit -m "$message"
          ;;
        *) echo "skip: dirty worktree"; return 0 ;;
      esac
    else
      echo "skip: dirty worktree"
      git -C "$repo" status --short
      if [[ "$upstream_remote" = "$BACKUP_REMOTE" && -z "$backup" ]]; then
        echo "note: external origin; add backup remote before scheduled sync can back this up"
      fi
      return 0
    fi
  fi

  run git -C "$repo" fetch --prune origin

  if ! upstream="$(git -C "$repo" rev-parse --abbrev-ref '@{u}' 2>/dev/null)"; then
    echo "skip pull: no upstream branch"
  else
    behind="$(git -C "$repo" rev-list --count "HEAD..$upstream")"

    if [[ "$behind" != "0" ]]; then
      run git -C "$repo" pull --ff-only
    else
      echo "ok: no remote changes"
    fi
  fi

  if [[ "$upstream_remote" = "$BACKUP_REMOTE" ]]; then
    if [[ -z "$backup" ]]; then
      echo "skip push: external origin and no $BACKUP_REMOTE remote"
      return 0
    fi
    echo "policy: origin is external; pushing committed state to $BACKUP_REMOTE only"
    run git -C "$repo" push "$BACKUP_REMOTE" "HEAD:refs/heads/$branch"
    return 0
  fi

  ahead="$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
  if [[ "$ahead" != "0" ]]; then
    run git -C "$repo" push
  else
    echo "ok: no committed changes to push"
  fi
}

main() {
  echo "workspace-sync mode=$mode dry_run=$dry_run roots=$SYNC_ROOTS github_org=${GITHUB_ORG:-<disabled>}"
  clone_missing_github_repos

  if [[ "$clone_only" = "1" ]]; then
    return 0
  fi

  # Portable replacement for `mapfile -t` (bash 4+, absent in macOS default bash 3.2).
  # The `|| [ -n "$repo" ]` guard keeps a final line that lacks a trailing newline.
  repos=()
  while IFS= read -r repo || [ -n "$repo" ]; do
    repos+=("$repo")
  done < <(discover_repos)

  if [[ "${#repos[@]}" = "0" ]]; then
    echo "No git repos found."
    return 0
  fi

  for repo in "${repos[@]}"; do
    sync_repo "$repo"
  done
}

if [[ "$dry_run" = "0" ]]; then
  exec 9>"$lock_file"
  if ! flock -n 9; then
    echo "Another workspace-sync is already running."
    exit 0
  fi
  main 2>&1 | tee -a "$log_file"
else
  main
fi
