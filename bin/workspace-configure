set -euo pipefail

config="${AI_WORKSPACE_CONFIG:-$HOME/.config/ai-workspace/config}"
mkdir -p "$(dirname "$config")"

if [[ -f "$config" ]]; then
  # shellcheck disable=SC1090
  source "$config"
fi

prompt() {
  local var="$1"
  local label="$2"
  local default="$3"
  local value

  read -r -p "$label [$default]: " value
  printf -v "$var" '%s' "${value:-$default}"
}

cat <<'EOF'
Configure AI Workspace for this machine.

Values are written only to the local config file, not to this repository.
Leave GitHub organization/user empty if you do not want helpers to create or use GitHub repos.
EOF
echo

prompt PROJECTS_HOME "Default directory for new projects" "${PROJECTS_HOME:-$HOME/projects}"
prompt PROJECT_ROOTS "Project picker roots, colon-separated" "${PROJECT_ROOTS:-$HOME/projects}"
prompt SYNC_ROOTS "Sync roots, colon-separated" "${SYNC_ROOTS:-$HOME/projects}"
prompt GITHUB_ORG "GitHub organization or user for owned repos and private mirrors" "${GITHUB_ORG:-}"
prompt GITHUB_SYNC_REPOS "Clone missing repos from GITHUB_ORG during workspace-sync? 1=yes, 0=no" "${GITHUB_SYNC_REPOS:-1}"
prompt GITHUB_CLONE_PROTOCOL "Clone GitHub repos with https or ssh" "${GITHUB_CLONE_PROTOCOL:-https}"
prompt GITHUB_REPO_LIMIT "Maximum GitHub repos to discover" "${GITHUB_REPO_LIMIT:-200}"
prompt BACKUP_REMOTE "Backup remote name for external/upstream repos" "${BACKUP_REMOTE:-backup}"
prompt CODEX_BIN "Codex binary path" "${CODEX_BIN:-$HOME/.local/bin/codex}"
prompt CLAUDE_BIN "Claude Code binary path" "${CLAUDE_BIN:-$HOME/.local/bin/claude}"
prompt SECRET_SCAN_CMD "Optional secret scan command before interactive commits; repo path is appended" "${SECRET_SCAN_CMD:-}"

{
  echo "# Local AI Workspace config."
  echo "# Generated by workspace-configure. Do not commit machine-specific values."
  printf 'PROJECTS_HOME=%q\n' "$PROJECTS_HOME"
  printf 'PROJECT_ROOTS=%q\n' "$PROJECT_ROOTS"
  printf 'SYNC_ROOTS=%q\n' "$SYNC_ROOTS"
  printf 'GITHUB_ORG=%q\n' "$GITHUB_ORG"
  printf 'GITHUB_SYNC_REPOS=%q\n' "$GITHUB_SYNC_REPOS"
  printf 'GITHUB_CLONE_PROTOCOL=%q\n' "$GITHUB_CLONE_PROTOCOL"
  printf 'GITHUB_REPO_LIMIT=%q\n' "$GITHUB_REPO_LIMIT"
  printf 'BACKUP_REMOTE=%q\n' "$BACKUP_REMOTE"
  printf 'CODEX_BIN=%q\n' "$CODEX_BIN"
  printf 'CLAUDE_BIN=%q\n' "$CLAUDE_BIN"
  printf 'SECRET_SCAN_CMD=%q\n' "$SECRET_SCAN_CMD"
} > "$config"

echo
echo "Wrote $config"
echo "Review with:"
echo "  sed -n '1,120p' $config"
